{
  "name": "urja-meter-api",
  "version": "1.0.0",
  "description": "Clean, documented API integration service over the Urja Meter Ops legacy portal",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
